pipeline {
    agent any

    environment {
        APP_NAME = 'python-flask-app'
        DOCKER_IMAGE = 'my-python-app:latest'
    }

    stages {
        // 1. ADIM: Kodlar artık Pipeline SCM ayarından (GitHub'dan) otomatik geliyor!
        stage('Checkout') {
            steps {
                echo "Kod GitHub deposundan çekildi. Workspace dizini: ${WORKSPACE}"
                sh 'ls -la'
            }
        }

        // 2. ADIM: SonarQube Statik Kod Analizi (Gerçek SCM & Git destekli)
        stage('SonarQube Analysis') {
            steps {
                script {
                    withCredentials([string(credentialsId: 'sonar-token', variable: 'MY_SONAR_TOKEN')]) {
                        echo 'SonarQube Statik Kod Analizi Başlatılıyor...'
                        
                        // Workspace okuma/yazma izinlerini garantiye alıyoruz
                        sh 'chmod -R 777 .'
                        
                        // NOT: -Dsonar.scm.disabled kaldırıldı! SCM artık Git'ten okunacak.
                        sh """
                            docker run --rm \
                              --net cicd-net \
                              -e SONAR_TOKEN="\${MY_SONAR_TOKEN}" \
                              -v \${WORKSPACE}:/usr/src \
                              sonarsource/sonar-scanner-cli \
                              -Dsonar.host.url=http://sonarqube:9000 \
                              -Dsonar.projectKey=${APP_NAME} \
                              -Dsonar.projectBaseDir=/usr/src \
                              -Dsonar.sources=.
                        """
                    }
                }
            }
        }

        // 3. ADIM: Docker İmajı Derleme
        stage('Build Docker Image') {
            steps {
                echo 'Docker İmajı Build Ediliyor...'
                sh 'docker build -t ${DOCKER_IMAGE} .'
            }
        }

        // 4. ADIM: İmajı Doğrulama
        stage('Test & Verify') {
            steps {
                echo 'Uygulama İmajı Doğrulanıyor...'
                sh 'docker images | grep my-python-app'
            }
        }
    }

    post {
        always {
            echo 'Pipeline tamamlandı.'
        }
        success {
            echo 'Tebrikler! Kod GitHub depodan alındı, analiz edildi ve build başarılı.'
        }
        failure {
            echo 'Hata! Pipeline bir adımda başarısız oldu.'
        }
    }
}
